# Конфиг для локальной разработки с Firebase Emulator Suite (npm run dev:emu).
# Значения фиктивные: demo-проект не ходит в облако.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-polygloto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-polygloto
VITE_FIREBASE_STORAGE_BUCKET=demo-polygloto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1
VITE_USE_EMULATORS=true
