rules_version = '2';
// Storage Polygloto. Пока хранятся только аватары:
//   avatars/{uid}/{fileName} — читают все, пишет и удаляет только владелец.
// Всё остальное закрыто (аудио для v2 получит свои правила).
// Лимиты продублированы из shared/schema.js (LIMITS.AVATAR_*).
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && fileName.matches('[A-Za-z0-9_-]{1,64}[.](jpg|jpeg|png|webp)')
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
